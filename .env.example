# ==============================================================================
# ROVON.UZ - Environment Configuration
# ==============================================================================

# Application
APP_ENV=development
APP_NAME=ROVON.UZ Media Intelligence
LOG_LEVEL=INFO
SECRET_KEY=rovon-super-secret-key-change-in-production-2026

# Database (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rovon_media

# Redis (Streams & Distributed Locks)
REDIS_URL=redis://localhost:6379/0

# AI Models (Google Gemini & OpenAI Fallback)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EDITORIAL_MODEL=gemini-1.5-pro
OPENAI_API_KEY=your_openai_api_key_optional

# Search API (Live Fact Checking)
TAVILY_API_KEY=your_tavily_api_key_here
GOOGLE_SEARCH_API_KEY=your_google_custom_search_api_key_optional
GOOGLE_SEARCH_CX=your_custom_search_cx_optional

# Telegram Dispatch Bot (Aiogram 3)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHANNEL_ID=@rovonuz
TELEGRAM_ADMIN_CHAT_ID=123456789

# Telegram Telemetry (Telethon MTProto Observer)
TELEGRAM_API_ID=your_telegram_api_id_here
TELEGRAM_API_HASH=your_telegram_api_hash_here
TELEGRAM_SESSION_NAME=rovon_observer_session

# Media Canvas Fonts
FONT_PATH_BOLD=app/media_studio/templates/fonts/Inter-Bold.ttf
FONT_PATH_REGULAR=app/media_studio/templates/fonts/Inter-Regular.ttf
ROVON_LOGO_PATH=app/media_studio/templates/branding/rovon_logo.png
